rules_version = '2';

// Security rules for the Sweet Toppers Firestore database.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's entitlements (purchased tutorials + subscription flag).
    // Only the owner may read. Writes should ideally happen from a trusted
    // backend after real payment confirmation; the rule below lets the signed-in
    // owner write so the dummy paywall works during development.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Topper suggestions: anyone may submit; only the owner/admin should read
    // (manage that from the Firebase console). No public reads.
    match /suggestions/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
