# Firebase web app config.
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase console → Project settings → General → Your apps → SDK setup & config
#
# Leave these blank to run the site in DEMO mode (simulated login + purchases).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
